<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 包可见性：让 PanelManager/AppLister 能经 PackageManager 读到系统里全部可启动 App（API 30+） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">
        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />
        <uses-library
            android:name="wear-sdk"
            android:required="false" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".presentation.screen.PetActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/TamagotchiTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 功能清单编辑页：独立全屏 Activity，承载全量枚举 IPC 与编辑交互 -->
        <activity
            android:name=".presentation.screen.QuickPanelEditActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/TamagotchiTheme.Full" />

        <!-- 设置页：M15/M17 统一入口（换宠归档 / 电子墓碑） -->
        <activity
            android:name=".presentation.screen.SettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/TamagotchiTheme.Full" />

        <!-- 电子墓碑页：墓碑列表 + 切回 -->
        <activity
            android:name=".presentation.screen.TombActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/TamagotchiTheme.Full" />

        <!-- 休闲小游戏页：M16，独立 Activity，与陪伴解耦 -->
        <activity
            android:name=".presentation.screen.GameActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/TamagotchiTheme.Full" />
    </application>

</manifest>
